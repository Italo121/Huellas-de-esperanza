# Configuración local para Docker Compose. No usar estos valores en producción.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_PORT=8000

# URL de una base PostgreSQL ya configurada con el esquema del proyecto.
DATABASE_URL=postgresql://usuario:contrasena@host:5432/base
DATABASE_SSLMODE=require

# Opcionales: necesarios solo si se usa Supabase Storage.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
